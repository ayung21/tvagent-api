#!/data/data/com.termux/files/usr/bin/bash

# --- KONFIGURASI ---
# Kita buat file log khusus widget (atau bisa diganti ke boot.log jika mau digabung)
LOG_FILE="$HOME/widget_pm2.log"
PM2CMD="/data/data/com.termux/files/usr/bin/node /data/data/com.termux/files/usr/lib/node_modules/pm2/bin/pm2"

# --- FUNGSI LOGGING ---
# Fungsi ini mencetak ke Layar DAN menyimpan ke File secara bersamaan
log_custom() {
  TIMESTAMP=$(date '+%a %b %d %H:%M:%S WIB %Y')
  echo "$TIMESTAMP - $1" | tee -a "$LOG_FILE"
}

# --- MULAI EKSEKUSI ---
log_custom "=== AKSES WIDGET DIMULAI ==="

log_custom "Menjalankan PM2 Resurrect..."
# '2>&1' artinya error juga ikut dicatat
# 'tee -a' artinya tampilkan di layar DAN tambahkan (append) ke file log
$PM2CMD resurrect 2>&1 | tee -a "$LOG_FILE"

echo "" | tee -a "$LOG_FILE"
log_custom "Status PM2 Terkini:"
$PM2CMD list 2>&1 | tee -a "$LOG_FILE"

log_custom "=== AKSES WIDGET SELESAI ==="

# Auto-close untuk semua Android TV / Google TV
if [ -f "/system/build.prop" ]; then
  CHARACTERISTICS="$(getprop ro.build.characteristics 2>/dev/null)"
  MODEL="$(getprop ro.product.model 2>/dev/null)"
  MANUFACTURER="$(getprop ro.product.manufacturer 2>/dev/null)"

  IS_TV=0

  # Sinyal paling akurat: device "characteristics" biasanya mengandung "tv"
  if [[ "${CHARACTERISTICS,,}" == *"tv"* ]]; then
    IS_TV=1
  fi

  # Fallback: beberapa device tidak mengisi characteristics dengan benar
  if [ "$IS_TV" -eq 0 ]; then
    if [[ "${MODEL,,}" == *"android tv"* ]] || [[ "${MODEL,,}" == *"google tv"* ]] || [[ "${MODEL,,}" == *"smart tv"* ]]; then
      IS_TV=1
    elif [[ "${MANUFACTURER,,}" == *"tcl"* ]]; then
      IS_TV=1
    fi
  fi

  if [ "$IS_TV" -eq 1 ]; then
    log_custom "Detected TV (${MANUFACTURER:-unknown} ${MODEL:-unknown}), exiting script only (PM2 stays running)."
    exit 0
  fi
fi

exit 0